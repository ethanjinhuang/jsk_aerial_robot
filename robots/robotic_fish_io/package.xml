<?xml version="1.0"?>
<package format="2">
  <name>robotic_fish_io</name>
  <version>0.1.0</version>
  <description>Timestamped ADC acquisition and safe DAC control for robotic_fish.</description>

  <maintainer email="ethanjinhuang@users.noreply.github.com">Ethan Jin Huang</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>

  <depend>diagnostic_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <build_export_depend>message_runtime</build_export_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>spinal</exec_depend>

  <test_depend>python3-nose</test_depend>

  <export/>
</package>
