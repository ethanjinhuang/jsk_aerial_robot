# Applied together at the next valid positive-going gait zero crossing.
# Full threshold-frame width on L/(L+R), [0,1]: 0.15 means +/-7.5%.
# Zero corrected difference selects straight even when threshold=0.
float64 threshold
float64 bias
# Volts: (left_mean-right_mean+value)/((left_mean+right_mean)/2).
# Must be finite; if left+value/2 or right-value/2 is negative, wait without applying.
float64 lr_voltage_offset_v
# -1 or +1 changes polarity; 0 keeps the currently effective polarity.
# All resolved settings apply atomically at the next valid full cycle.
int8 left_bias_sign
# Signed bar-share offset, [-0.5,0.5]: left share += value, right share -= value.
# +0.05 is equivalent to shifting the threshold frame LEFT by 5 percentage points.
# -0.05 shifts it RIGHT by 5 points. Original measured voltages remain unchanged.
float64 lr_ratio_offset
---
bool success
string message
# Snapshot at request processing time; success means accepted, not yet applied.
uint64 request_id
string difference_reference
string motion_mode
string status
string reason
string direction
string adc_quality
float64 command_bias
# Currently effective settings, even when this request is rejected.
float64 active_threshold
float64 active_bias
float64 active_lr_voltage_offset_v
int8 active_left_bias_sign
float64 active_lr_ratio_offset
bool parameters_pending
# Zero ID and NaN values when no request is pending.
uint64 pending_request_id
float64 pending_threshold
float64 pending_bias
float64 pending_lr_voltage_offset_v
# 0 when no request is pending (float pending values above are NaN).
int8 pending_left_bias_sign
# NaN when no request is pending.
float64 pending_lr_ratio_offset
