# Applied together at the next valid positive-going gait zero crossing.
float64 threshold
float64 bias
# Dimensionless baseline subtracted from (left_mean-right_mean)/(left_mean+right_mean).
float64 lr_offset
---
bool success
string message
# Snapshot at request processing time; success means accepted, not yet applied.
uint64 request_id
string motion_mode
string status
string reason
string direction
string adc_quality
float64 command_bias
# Currently effective settings, even when this request is rejected.
float64 active_threshold
float64 active_bias
float64 active_lr_offset
bool parameters_pending
# Zero ID and NaN values when no request is pending.
uint64 pending_request_id
float64 pending_threshold
float64 pending_bias
float64 pending_lr_offset
