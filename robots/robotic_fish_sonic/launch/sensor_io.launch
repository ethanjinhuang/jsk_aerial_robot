<?xml version="1.0"?>
<launch>
  <arg name="config" default="$(find robotic_fish_sonic)/config/io.yaml"/>
  <arg name="enable_adc" default="true"/>
  <arg name="enable_dac" default="true"/>
  <arg name="enable_gain_control" default="true"/>
  <!-- Deprecated compatibility alias. true selects closed_loop. -->
  <!-- Empty overrides preserve YAML; explicit CLI values use canonical keys. -->
  <arg name="enable_agc" default=""/>
  <arg name="gain_mode" default=""/>
  <arg name="manual_gain_voltage" default=""/>
  <arg name="agc_target_min_v" default=""/>
  <arg name="agc_target_max_v" default=""/>
  <arg name="agc_step_v" default=""/>
  <arg name="adc_safety_limit_v" default=""/>

  <node if="$(arg enable_adc)"
        pkg="robotic_fish_sonic"
        type="adc_node.py"
        name="adc"
        output="screen">
    <rosparam command="load" file="$(arg config)"/>
  </node>

  <node if="$(arg enable_dac)"
        pkg="robotic_fish_sonic"
        type="dac_node.py"
        name="dac"
        output="screen">
    <rosparam command="load" file="$(arg config)"/>
  </node>

  <node if="$(eval arg('enable_adc') and arg('enable_dac') and arg('enable_gain_control'))"
        pkg="robotic_fish_sonic"
        type="agc_node.py"
        name="gain_control"
        output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param if="$(eval arg('enable_agc') != '')" name="agc/enabled" type="bool" value="$(arg enable_agc)"/>
    <param if="$(eval arg('gain_mode') != '')" name="gain_control/mode" type="str" value="$(arg gain_mode)"/>
    <param if="$(eval arg('manual_gain_voltage') != '')" name="gain_control/manual_target_voltage_v" type="double" value="$(arg manual_gain_voltage)"/>
    <param if="$(eval arg('agc_target_min_v') != '')" name="gain_control/target_min_voltage_v" type="double" value="$(arg agc_target_min_v)"/>
    <param if="$(eval arg('agc_target_max_v') != '')" name="gain_control/target_max_voltage_v" type="double" value="$(arg agc_target_max_v)"/>
    <param if="$(eval arg('agc_step_v') != '')" name="gain_control/voltage_step_v" type="double" value="$(arg agc_step_v)"/>
    <param if="$(eval arg('adc_safety_limit_v') != '')" name="gain_control/adc_safety_trigger_voltage_v" type="double" value="$(arg adc_safety_limit_v)"/>
  </node>
</launch>
