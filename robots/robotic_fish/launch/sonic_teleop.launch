<?xml version="1.0"?>
<launch>
  <arg name="auto_frequency" default="1.5"/>
  <arg name="acoustic_steering" default="false"/>
  <arg name="acoustic_threshold" default="0.1"/>
  <arg name="acoustic_bias" default="256.0"/>
  <arg name="left_bias_sign" default="1"/>
  <arg name="joy_timeout_s" default="0.5"/>
  <arg name="update_rate" default="50.0"/>
  <arg name="joy_autorepeat_rate" default="20.0"/>
  <arg name="steering_axis" default="2"/>
  <arg name="amplitude_decrease_axis" default="3"/>
  <arg name="amplitude_increase_axis" default="4"/>
  <arg name="stop_button" default="1"/>
  <arg name="auto_button" default="3"/>
  <arg name="manual_button" default="0"/>
  <arg name="tracking_button" default="2"/>
  <arg name="amplitude_buttons" default="[6, 7]"/>

  <node pkg="robotic_fish" type="sonic_teleop.py" name="sonic_teleop_node" output="screen">
    <param name="joy_dead_zone" value="0.1"/>
    <param name="servo_center" value="2048.0"/>
    <param name="servo_range" value="1024.0"/>
    <param name="auto_frequency" value="$(arg auto_frequency)"/>
    <param name="acoustic_steering/enabled" type="bool" value="$(arg acoustic_steering)"/>
    <param name="acoustic_steering/threshold" value="$(arg acoustic_threshold)"/>
    <param name="acoustic_steering/bias" value="$(arg acoustic_bias)"/>
    <param name="acoustic_steering/left_bias_sign" type="int" value="$(arg left_bias_sign)"/>
    <param name="auto_default_amplitude" value="512.0"/>
    <param name="auto_amplitude_rate" value="64.0"/>
    <param name="joy_timeout_s" value="$(arg joy_timeout_s)"/>
    <param name="update_rate" value="$(arg update_rate)"/>
    <param name="steering_axis" type="int" value="$(arg steering_axis)"/>
    <param name="amplitude_decrease_axis" type="int" value="$(arg amplitude_decrease_axis)"/>
    <param name="amplitude_increase_axis" type="int" value="$(arg amplitude_increase_axis)"/>
    <param name="stop_button" type="int" value="$(arg stop_button)"/>
    <param name="auto_button" type="int" value="$(arg auto_button)"/>
    <param name="manual_button" type="int" value="$(arg manual_button)"/>
    <param name="tracking_button" type="int" value="$(arg tracking_button)"/>
    <rosparam param="amplitude_buttons" subst_value="true">$(arg amplitude_buttons)</rosparam>
  </node>

  <node pkg="joy" type="joy_node" name="joy_node" output="screen" >

    <param name="dev" value="/dev/input/js0"/>
    <param name="coalesce_interval" value="0.025"/>
    <param name="autorepeat_rate" value="$(arg joy_autorepeat_rate)"/>
  </node>
</launch>
