<?xml version="1.0"?>
<launch>
  <arg name="enabled" default="true"/>
  <arg name="record_diagnostics" default="false"/>
  <arg name="diagnostics_topic" value="$(eval '/diagnostics' if arg('record_diagnostics') else '')"/>
  <arg name="bag_prefix" default="$(env HOME)/sonic"/>

  <node if="$(arg enabled)"
        pkg="rosbag"
        type="record"
        name="sonic_bag_recorder"
        output="screen"
        args="-o $(arg bag_prefix)
              /robotic_fish/adc/samples
              /robotic_fish/dac/state
              /robotic_fish/gain_control/state
              /robotic_fish/gain_control/config
              $(arg diagnostics_topic)
              /joy
              /imu
              /servo/target_states
              /servo/states"/>
</launch>
