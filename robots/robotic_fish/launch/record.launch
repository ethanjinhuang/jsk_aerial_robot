<?xml version="1.0"?>
<launch>
  <arg name="enabled" default="true"/>
  <arg name="record_diagnostics" default="true"/>
  <arg name="diagnostics_topic" value="$(eval '/diagnostics' if arg('record_diagnostics') else '')"/>
  <arg name="bag_prefix" default="$(env HOME)/sonic"/>

  <node if="$(arg enabled)"
        pkg="rosbag"
        type="record"
        name="sonic_bag_recorder"
        output="screen"
        args="-o $(arg bag_prefix)
              /robotic_fish/adc/samples
              /robotic_fish/dac/state
              /robotic_fish/gain_control/state
              /robotic_fish/gain_control/config
              /robotic_fish/acoustic/quadrant_probabilities
              /robotic_fish/acoustic/channel_comparison
              /robotic_fish/acoustic/steering_state
              /robotic_fish/sonic/status_snapshot
              /robotic_fish/sonic/motion_state
              /robotic_fish/sonic/config
              /robotic_fish/acoustic/steering_events
              /rosout
              $(arg diagnostics_topic)
              /joy
              /imu
              /servo/target_states
              /servo/states"/>
</launch>
