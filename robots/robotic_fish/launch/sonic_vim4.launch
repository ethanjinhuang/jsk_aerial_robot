<?xml version="1.0"?>
<launch>
  <!-- Daily VIM4 entry; the PC runs only joy.launch. -->
  <!-- io_config takes precedence over the legacy config alias. -->
  <arg name="config" default=""/>
  <arg name="io_config" default="$(eval arg('config') or find('robotic_fish_sonic') + '/config/io.yaml')"/>
  <arg name="motion_config" default="$(find robotic_fish)/config/motion.yaml"/>
  <arg name="enable_motion" default="true"/>
  <arg name="enable_bridge" default="true"/>
  <arg name="record" default="false"/>
  <arg name="bag_prefix" default="/home/khadas/ros/rosbag/sonic"/>
  <arg name="record_diagnostics" default="true"/>
  <arg name="spinal_mode" default="serial"/>
  <!-- Intentional experiment-scene defaults; numeric defaults live in YAML. -->
  <arg name="gain_mode" default="manual"/>
  <arg name="manual_gain_voltage" default=""/>
  <arg name="agc_target_min_v" default=""/>
  <arg name="agc_target_max_v" default=""/>
  <arg name="agc_step_v" default=""/>
  <arg name="adc_safety_limit_v" default=""/>
  <arg name="enable_status_console" default="true"/>
  <arg name="status_color" default="auto"/>
  <arg name="auto_frequency" default=""/>
  <arg name="acoustic_steering" default="true"/>
  <arg name="acoustic_threshold" default=""/>
  <arg name="acoustic_bias" default=""/>
  <arg name="acoustic_lr_voltage_offset_v" default=""/>
  <arg name="acoustic_max_age_s" default=""/>
  <arg name="acoustic_future_tolerance_s" default=""/>
  <arg name="left_bias_sign" default=""/>
  <arg name="joy_timeout_s" default=""/>
  <arg name="joy_timeout_action" default=""/>
  <arg name="update_rate" default=""/>

  <include if="$(arg enable_bridge)" file="$(find spinal)/launch/bridge.launch">
    <arg name="dev" value="vim4"/>
    <arg name="mode" value="$(arg spinal_mode)"/>
  </include>

  <include file="$(find robotic_fish_sonic)/launch/sensor_io.launch">
    <arg name="config" value="$(arg io_config)"/>
    <arg name="gain_mode" value="$(arg gain_mode)"/>
    <arg name="manual_gain_voltage" value="$(arg manual_gain_voltage)"/>
    <arg name="agc_target_min_v" value="$(arg agc_target_min_v)"/>
    <arg name="agc_target_max_v" value="$(arg agc_target_max_v)"/>
    <arg name="agc_step_v" value="$(arg agc_step_v)"/>
    <arg name="adc_safety_limit_v" value="$(arg adc_safety_limit_v)"/>
  </include>

  <include if="$(arg enable_motion)" file="$(find robotic_fish)/launch/sonic_teleop.launch">
    <arg name="enable_joy" value="false"/>
    <arg name="motion_config" value="$(arg motion_config)"/>
    <arg name="auto_frequency" value="$(arg auto_frequency)"/>
    <arg name="acoustic_steering" value="$(arg acoustic_steering)"/>
    <arg name="acoustic_threshold" value="$(arg acoustic_threshold)"/>
    <arg name="acoustic_bias" value="$(arg acoustic_bias)"/>
    <arg name="acoustic_lr_voltage_offset_v" value="$(arg acoustic_lr_voltage_offset_v)"/>
    <arg name="acoustic_max_age_s" value="$(arg acoustic_max_age_s)"/>
    <arg name="acoustic_future_tolerance_s" value="$(arg acoustic_future_tolerance_s)"/>
    <arg name="left_bias_sign" value="$(arg left_bias_sign)"/>
    <arg name="joy_timeout_s" value="$(arg joy_timeout_s)"/>
    <arg name="joy_timeout_action" value="$(arg joy_timeout_action)"/>
    <arg name="update_rate" value="$(arg update_rate)"/>
  </include>

  <include if="$(arg enable_status_console)" file="$(find robotic_fish_sonic)/launch/status_console.launch">
    <arg name="color" value="$(arg status_color)"/>
  </include>

  <include if="$(arg record)" file="$(find robotic_fish)/launch/record.launch">
    <arg name="bag_prefix" value="$(arg bag_prefix)"/>
    <arg name="record_diagnostics" value="$(arg record_diagnostics)"/>
  </include>
</launch>
